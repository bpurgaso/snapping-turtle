# dependencies / build output
node_modules/
dist/
*.tsbuildinfo

# secrets — never commit; keep deploy/.env.example current instead (CLAUDE.md rule 12)
.env
.env.*
!.env.example
deploy/.env

# local image store (server default IMAGES_DIR)
data/

# operator-local Caddy site blocks (the old-domain redirect); the example and README are tracked
deploy/caddy.d/*.caddy

# signed Firefox artifacts published by `sign:firefox` (served at /ext/); build output, not source
deploy/ext/*
!deploy/ext/README.md

# test artifacts
coverage/
playwright-report/
test-results/
blob-report/

# editor / OS
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
*.log
