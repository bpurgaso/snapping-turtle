# Local/LAN variant: the same listener on PUBLIC_HOST:PUBLIC_PORT, but with
# Caddy's internal CA instead of ACME DNS-01, so any hostname works without a
# DNS zone or a provider token. Mounted by docker-compose.local.yml; also what
# the domain-migration rehearsal and the README walkthrough run against.
{
	auto_https disable_redirects
	servers {
		timeouts {
			read_header 10s
			read_body 60s
			idle 2m
		}
	}
	order rate_limit before basic_auth
}

# Same snippet name as the main Caddyfile, so an old-domain block written
# per deploy/caddy.d/old-domain.caddy.example works unchanged in local
# rehearsals — here it means the internal CA.
(tls_dns) {
	tls internal
}

(site) {
	encode zstd gzip
	request_body {
		max_size {$MAX_UPLOAD_MB}MB
	}
	rate_limit {
		zone per_ip {
			key {remote_host}
			events {$CADDY_RATE_PER_IP_PER_MIN:300}
			window 1m
		}
	}
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}
	@internal path /healthz
	respond @internal 404
	reverse_proxy app:3000 {
		header_up X-Forwarded-Proto {scheme}
	}
}

{$PUBLIC_HOST}:{$PUBLIC_PORT} {
	import tls_dns
	import site
}

# Same as Caddyfile: extra site blocks (old-domain redirect) from deploy/caddy.d/.
import /etc/caddy/sites.d/*.caddy
