# snapping-turtle configuration — copy to deploy/.env and edit.
# Both `docker compose -f deploy/docker-compose.yml` and local `pnpm dev`
# read this file. Never commit deploy/.env (it is git-ignored).
# Every variable from PLAN.md §14 is here; keep this file current when adding config.

# ---- Public identity --------------------------------------------------------
# Hostname only (no scheme). Caddy obtains a Let's Encrypt cert for it and the
# app derives PUBLIC_ORIGIN=https://$PUBLIC_HOST. Domain migration = change this
# and `docker compose up -d`. Use `localhost` for local TLS via Caddy's internal CA.
PUBLIC_HOST=shots.example.com

# ---- Retention (days) -------------------------------------------------------
RETENTION_DEFAULT_DAYS=30
RETENTION_MAX_DAYS_USER=365

# ---- Upload cap (MB) — enforced by Caddy and the app; default matches shared/ ---
MAX_UPLOAD_MB=30

# ---- Guard knobs (PLAN.md §12) — defaults come from shared/GUARD_DEFAULTS ---
RATE_GENERAL_PER_MIN=60
RATE_INVALID_LOOKUP_BUDGET=5
RATE_INVALID_LOOKUP_WINDOW_MIN=10
RATE_BREAKER_INVALID_PER_MIN=100

# ---- Database ---------------------------------------------------------------
# Compose builds the app's DATABASE_URL from these three; the postgres service
# is only reachable on the internal network.
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me-generate-with-openssl-rand-hex-24
POSTGRES_DB=snapping_turtle
# Local dev only (pnpm dev / db:migrate / db:seed against your own Postgres).
# Ignored by compose, which sets its own.
DATABASE_URL=postgres://app:change-me@localhost:5432/snapping_turtle

# ---- Secrets — generate, never reuse the placeholders -----------------------
# openssl rand -base64 48
SESSION_SECRET=change-me-generate-at-least-32-bytes-of-randomness

# ---- One-time admin bootstrap (pnpm --filter server db:seed) ----------------
# Lowercase letters/digits/_ . -, 2–32 chars. Password ≥ 12 chars. Remove after seeding.
ADMIN_BOOTSTRAP_USER=admin
ADMIN_BOOTSTRAP_PASSWORD=change-me-at-least-twelve-chars

# ---- App runtime ------------------------------------------------------------
LOG_LEVEL=info
# Set only when behind Caddy (compose does); local dev leaves it unset.
# TRUST_PROXY=true
