# snapping-turtle configuration — copy to deploy/.env and edit.
# Both `docker compose -f deploy/docker-compose.yml` and local `pnpm dev`
# read this file. Never commit deploy/.env (it is git-ignored).
# Every variable from PLAN.md §14 is here; keep this file current when adding config.

# ---- Public identity --------------------------------------------------------
# Hostname only (no scheme, no port). Caddy obtains a Let's Encrypt cert for it
# via the DNS-01 challenge and compose derives
# PUBLIC_ORIGIN=https://$PUBLIC_HOST:$PUBLIC_PORT for the app. Domain migration
# = change this and `docker compose up -d` (docs/runbooks/domain-migration.md).
# Local runs (localhost, a LAN name) use docker-compose.local.yml, which swaps
# ACME for Caddy's internal CA.
PUBLIC_HOST=shots.example.com
# The one inbound port (TCP + UDP) the host publishes; nothing listens on 80 or
# 443. Every generated URL carries it. Moving off 443 avoids conflicts with
# other services and trims surface — it is NOT a defence (scanners sweep every
# port); the capability URLs and the guard are. 28443 is below Linux's default
# ephemeral range (32768+), so no port reservation is needed on the host.
PUBLIC_PORT=28443
# Cloudflare API token for DNS-01 issuance and renewal: Zone → Zone → Read plus
# Zone → DNS → Edit, restricted to this one zone (DNS:Edit alone fails the
# plugin's zone lookup). Read only by Caddy, from its environment; never logged.
# Renewal stops working the day this token is revoked or expires. Not needed
# for local runs under docker-compose.local.yml. The DNS record for
# PUBLIC_HOST must be DNS-only (grey cloud): Cloudflare's proxy neither forwards
# PUBLIC_PORT nor coexists with a certificate issued to this origin.
CLOUDFLARE_API_TOKEN=

# ---- Retention (days) -------------------------------------------------------
RETENTION_DEFAULT_DAYS=30
RETENTION_MAX_DAYS_USER=365
# Deleted or expired captures keep a tombstone row (owner, source URL, sha256,
# timestamps — no image, no annotations) this long before the hourly purge
# job hard-deletes it (PLAN.md §5, §13).
TOMBSTONE_DAYS=90

# ---- Upload cap (MB) — enforced by Caddy and the app; default matches shared/ ---
MAX_UPLOAD_MB=30

# ---- Guard knobs (PLAN.md §12) — defaults come from shared/GUARD_DEFAULTS ---
RATE_GENERAL_PER_MIN=60
RATE_INVALID_LOOKUP_BUDGET=5
RATE_INVALID_LOOKUP_WINDOW_MIN=10
RATE_BREAKER_INVALID_PER_MIN=100
# Seconds the breaker stays open before half-open probes are admitted.
RATE_BREAKER_COOLDOWN_SECONDS=300
# Escalating ban durations per strike (minutes); the last rung repeats.
RATE_BAN_LADDER_MINUTES=15,60,1440
# Coarse per-IP cap at the Caddy layer (requests/minute) — flood shedding
# only; the app guard above is the real enforcement layer.
CADDY_RATE_PER_IP_PER_MIN=300
# Random delay (ms) added to every not-found response under /s/* (PLAN.md §6).
RATE_NOT_FOUND_JITTER_MIN_MS=30
RATE_NOT_FOUND_JITTER_MAX_MS=150

# ---- Sign-in (PLAN.md §11) --------------------------------------------------
# Browser sessions live this long; rotating SESSION_SECRET signs everyone out.
SESSION_TTL_DAYS=30
# Per-account backoff: after FREE_ATTEMPTS consecutive failures the account is
# locked for BASE_SECONDS, doubling per further failure, capped at MAX_SECONDS.
LOGIN_THROTTLE_FREE_ATTEMPTS=5
LOGIN_THROTTLE_BASE_SECONDS=5
LOGIN_THROTTLE_MAX_SECONDS=3600

# ---- Image store ------------------------------------------------------------
# Re-encoded originals, {shard}/{id}.png. Compose mounts the `images` volume at
# /data/images and sets this itself; local dev defaults to <repo>/data/images.
# IMAGES_DIR=/data/images

# ---- Extension distribution (PLAN.md §15, M8) ---------------------------------
# Firefox add-on id. AMO ties every signature to this id, so pick it once
# before the first `sign:firefox` and never change it — not even when the
# domain migrates (docs/runbooks/domain-migration.md). Any name@host works.
EXTENSION_GECKO_ID=snapping-turtle@shots.example.com
# Where the app serves the signed .xpi + updates.json from at /ext/. Compose
# bind-mounts deploy/ext here and sets this itself; local dev defaults to
# <repo>/deploy/ext.
# EXT_DIR=/data/ext
# The Chrome Web Store listing URL (https://chromewebstore.google.com/detail/<id>)
# once the unlisted item is approved (extension/STORE_SUBMISSION.md). Unlisted
# items cannot be found by store search, so the home page links this directly;
# while it is unset the Chrome install card reads "coming soon". Firefox needs
# nothing here: the home page links /ext/firefox-latest, which resolves the
# newest signed .xpi from updates.json on every request.
CHROME_EXTENSION_URL=
# AMO API credentials (WEB_EXT_API_KEY / WEB_EXT_API_SECRET) do NOT belong in
# this file or any other: export them in the shell that runs sign:firefox
# (extension/STORE_SUBMISSION.md).

# ---- Database ---------------------------------------------------------------
# Compose builds two connection strings from these; the postgres service is
# only reachable on the internal network. POSTGRES_USER is the privileged
# role: it owns the schema and runs migrations (MIGRATE_DATABASE_URL). The
# app itself runs as `st_app` (created by migration 0002), which cannot
# UPDATE or DELETE audit_log rows — that is what keeps the audit trail
# append-only (CLAUDE.md rule 7). st_app's password is APP_DB_PASSWORD,
# synced into Postgres at boot.
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me-generate-with-openssl-rand-hex-24
POSTGRES_DB=snapping_turtle
APP_DB_PASSWORD=change-me-generate-with-openssl-rand-hex-24
# Local dev only (pnpm dev / db:migrate / db:seed against your own Postgres).
# Ignored by compose, which sets its own.
DATABASE_URL=postgres://app:change-me@localhost:5432/snapping_turtle
# Optional for local dev: set to run migrations as a different, more
# privileged role than the app connects with (compose always sets it).
# MIGRATE_DATABASE_URL=

# ---- Secrets — generate, never reuse the placeholders -----------------------
# openssl rand -base64 48
SESSION_SECRET=change-me-generate-at-least-32-bytes-of-randomness

# ---- One-time admin bootstrap (pnpm --filter server db:seed) ----------------
# Lowercase letters/digits/_ . -, 2–32 chars. Password ≥ 12 chars. Remove after seeding.
ADMIN_BOOTSTRAP_USER=admin
ADMIN_BOOTSTRAP_PASSWORD=change-me-at-least-twelve-chars

# ---- Backups (PLAN.md §12) ----------------------------------------------------
# The backup sidecar runs nightly at this UTC time: pg_dump + a hardlinked
# snapshot of the image volume into the `backups` volume, rotated after
# BACKUP_KEEP_DAYS. Set BACKUP_ON_START=true to also back up on every boot.
BACKUP_TIME_UTC=03:30
BACKUP_KEEP_DAYS=14
BACKUP_ON_START=false
# Off-box copy — strongly recommended; without it a backup lives on the same
# disk as the data. Any restic backend works, e.g.
#   RESTIC_REPOSITORY=s3:s3.amazonaws.com/my-bucket/snapping-turtle   (+ AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY)
#   RESTIC_REPOSITORY=b2:my-bucket:snapping-turtle                    (+ B2_ACCOUNT_ID / B2_ACCOUNT_KEY)
#   RESTIC_REPOSITORY=rest:https://user:pass@backup.example.com/st    (restic REST server)
# RESTIC_PASSWORD encrypts the repository; losing it loses the backups.
# RESTIC_REPOSITORY=
# RESTIC_PASSWORD=
RESTIC_KEEP_DAILY=14
RESTIC_KEEP_WEEKLY=8
RESTIC_KEEP_MONTHLY=6

# ---- App runtime ------------------------------------------------------------
LOG_LEVEL=info
# Set only when behind a proxy. `true`, `false`, or a comma-separated list of
# CIDRs that may assert X-Forwarded-For (compose pins it to the Caddy network
# subnet so nothing else can spoof client IPs at the guard). Local dev leaves
# it unset.
# TRUST_PROXY=172.28.101.0/24
