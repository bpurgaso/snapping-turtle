# snapping-turtle configuration — copy to deploy/.env and edit.
# Both `docker compose -f deploy/docker-compose.yml` and local `pnpm dev`
# read this file. Never commit deploy/.env (it is git-ignored).
# Every variable from PLAN.md §14 is here; keep this file current when adding config.

# ---- Public identity --------------------------------------------------------
# Hostname only (no scheme). Caddy obtains a Let's Encrypt cert for it and the
# app derives PUBLIC_ORIGIN=https://$PUBLIC_HOST. Domain migration = change this
# and `docker compose up -d`. Use `localhost` for local TLS via Caddy's internal CA.
PUBLIC_HOST=shots.example.com

# ---- Retention (days) -------------------------------------------------------
RETENTION_DEFAULT_DAYS=30
RETENTION_MAX_DAYS_USER=365

# ---- Upload cap (MB) — enforced by Caddy and the app; default matches shared/ ---
MAX_UPLOAD_MB=30

# ---- Guard knobs (PLAN.md §12) — defaults come from shared/GUARD_DEFAULTS ---
RATE_GENERAL_PER_MIN=60
RATE_INVALID_LOOKUP_BUDGET=5
RATE_INVALID_LOOKUP_WINDOW_MIN=10
RATE_BREAKER_INVALID_PER_MIN=100
# Seconds the breaker stays open before half-open probes are admitted.
RATE_BREAKER_COOLDOWN_SECONDS=300
# Escalating ban durations per strike (minutes); the last rung repeats.
RATE_BAN_LADDER_MINUTES=15,60,1440
# Random delay (ms) added to every not-found response under /s/* (PLAN.md §6).
RATE_NOT_FOUND_JITTER_MIN_MS=30
RATE_NOT_FOUND_JITTER_MAX_MS=150

# ---- Sign-in (PLAN.md §11) --------------------------------------------------
# Browser sessions live this long; rotating SESSION_SECRET signs everyone out.
SESSION_TTL_DAYS=30
# Per-account backoff: after FREE_ATTEMPTS consecutive failures the account is
# locked for BASE_SECONDS, doubling per further failure, capped at MAX_SECONDS.
LOGIN_THROTTLE_FREE_ATTEMPTS=5
LOGIN_THROTTLE_BASE_SECONDS=5
LOGIN_THROTTLE_MAX_SECONDS=3600

# ---- Image store ------------------------------------------------------------
# Re-encoded originals, {shard}/{id}.png. Compose mounts the `images` volume at
# /data/images and sets this itself; local dev defaults to <repo>/data/images.
# IMAGES_DIR=/data/images

# ---- Database ---------------------------------------------------------------
# Compose builds two connection strings from these; the postgres service is
# only reachable on the internal network. POSTGRES_USER is the privileged
# role: it owns the schema and runs migrations (MIGRATE_DATABASE_URL). The
# app itself runs as `st_app` (created by migration 0002), which cannot
# UPDATE or DELETE audit_log rows — that is what keeps the audit trail
# append-only (CLAUDE.md rule 7). st_app's password is APP_DB_PASSWORD,
# synced into Postgres at boot.
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me-generate-with-openssl-rand-hex-24
POSTGRES_DB=snapping_turtle
APP_DB_PASSWORD=change-me-generate-with-openssl-rand-hex-24
# Local dev only (pnpm dev / db:migrate / db:seed against your own Postgres).
# Ignored by compose, which sets its own.
DATABASE_URL=postgres://app:change-me@localhost:5432/snapping_turtle
# Optional for local dev: set to run migrations as a different, more
# privileged role than the app connects with (compose always sets it).
# MIGRATE_DATABASE_URL=

# ---- Secrets — generate, never reuse the placeholders -----------------------
# openssl rand -base64 48
SESSION_SECRET=change-me-generate-at-least-32-bytes-of-randomness

# ---- One-time admin bootstrap (pnpm --filter server db:seed) ----------------
# Lowercase letters/digits/_ . -, 2–32 chars. Password ≥ 12 chars. Remove after seeding.
ADMIN_BOOTSTRAP_USER=admin
ADMIN_BOOTSTRAP_PASSWORD=change-me-at-least-twelve-chars

# ---- App runtime ------------------------------------------------------------
LOG_LEVEL=info
# Set only when behind a proxy. `true`, `false`, or a comma-separated list of
# CIDRs that may assert X-Forwarded-For (compose pins it to the Caddy network
# subnet so nothing else can spoof client IPs at the guard). Local dev leaves
# it unset.
# TRUST_PROXY=172.28.101.0/24
