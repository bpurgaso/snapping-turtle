# Caddy with the per-IP rate-limit plugin (PLAN.md §12). Default Caddy builds
# carry no request-rate module, so the coarse outer cap needs xcaddy and
# github.com/mholt/caddy-ratelimit — pinned, never @latest: the proxy
# terminates TLS and an unpinned third-party module there is supply-chain
# surface. The app guard remains the enforcement layer; this only sheds
# dumb floods before they reach Node.

# Exact patch release, not a floating minor: what Trivy scanned is what runs.
ARG CADDY_VERSION=2.11.4
FROM caddy:${CADDY_VERSION}-builder AS builder
# The --replace lines bump Go modules Caddy 2.11.4 still pins at versions
# with fixed HIGH/CRITICAL CVEs (Trivy gates the built binary in CI). Drop
# them once a Caddy release carries these or newer.
RUN xcaddy build \
    --with github.com/mholt/caddy-ratelimit@5625512f24f6f59d6f64fb3aafe5eecff0b286db \
    --replace golang.org/x/crypto=golang.org/x/crypto@v0.55.0 \
    --replace golang.org/x/net=golang.org/x/net@v0.58.0 \
    --replace golang.org/x/text=golang.org/x/text@v0.39.0 \
    --replace google.golang.org/grpc=google.golang.org/grpc@v1.82.1

FROM caddy:${CADDY_VERSION}-alpine
RUN apk upgrade --no-cache
COPY --from=builder /usr/bin/caddy /usr/bin/caddy
