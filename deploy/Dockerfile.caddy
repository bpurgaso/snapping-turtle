# Caddy built with xcaddy and two plugins (PLAN.md §12, §14):
#
#   - github.com/caddy-dns/cloudflare — the ACME DNS-01 challenge provider.
#     Certificates are issued and renewed by proving control of the DNS zone
#     through the provider's API, so the host needs no inbound 80/443 at
#     all and the only published port is PUBLIC_PORT. Swapping providers is
#     a one-arg rebuild: --build-arg CADDY_DNS_MODULE=github.com/caddy-dns/<provider>@<version>
#     plus the matching `dns <provider>` line in deploy/Caddyfile (the
#     provider's own credential env var replaces CLOUDFLARE_API_TOKEN).
#   - github.com/mholt/caddy-ratelimit — the coarse per-IP request cap.
#     Default Caddy builds carry no request-rate module.
#
# Both are pinned (a tag or a commit, never @latest): the proxy terminates
# TLS and holds the DNS API token, so an unpinned third-party module here is
# supply-chain surface. The app guard remains the enforcement layer; the
# rate limit only sheds dumb floods before they reach Node.

# Exact patch release for both the builder and the runtime image, not a
# floating minor: what Trivy scanned in CI is what runs.
ARG CADDY_VERSION=2.11.7
# DNS-01 provider module. Zone → Zone → Read plus Zone → DNS → Edit on the
# one zone is the least privilege the Cloudflare plugin works with
# (deploy/README.md "TLS").
ARG CADDY_DNS_MODULE=github.com/caddy-dns/cloudflare@v0.2.4

FROM caddy:${CADDY_VERSION}-builder AS builder
ARG CADDY_DNS_MODULE
# The --replace lines bump Go modules Caddy 2.11.7 still pins at versions
# with a fixed HIGH CVE (Trivy gates the built binary in CI). Each is
# dropped once a Caddy release carries the fixed version itself:
#   - x/net v0.59.0 → v0.61.0: CVE-2026-78669 in http2 (SETTINGS flood).
#     Still needed on 2026-10-29: 2.11.7 resolves v0.59.0 without it.
#   - go-jose/v4 v4.1.5 → v4.1.6 (indirect, via certmagic/acmez/smallstep):
#     CVE-2026-116587 (GHSA-mgcc-cww5-fp2q), DoS parsing JWKs with RSA keys;
#     turned the scan red on 2026-10-29.
# 2.11.7 itself carries x/crypto, x/text, klauspost/compress and grpc at
# fixed versions, and its builder image ships Go 1.27.3 (stdlib
# CVE-2026-78667 / -78669 / -97031 fixed in 1.27.2), so the earlier
# replace lines for those are gone.
RUN xcaddy build \
    --with "${CADDY_DNS_MODULE}" \
    --with github.com/mholt/caddy-ratelimit@5625512f24f6f59d6f64fb3aafe5eecff0b286db \
    --replace golang.org/x/net=golang.org/x/net@v0.61.0 \
    --replace github.com/go-jose/go-jose/v4=github.com/go-jose/go-jose/v4@v4.1.6

# Named so CI can exclude it from the build cache (ci.yml no-cache-filters):
# the apk upgrade below only picks up Alpine's fixes when it actually runs,
# and a cached layer would serve last month's packages to today's Trivy scan.
FROM caddy:${CADDY_VERSION}-alpine AS runtime
RUN apk upgrade --no-cache
COPY --from=builder /usr/bin/caddy /usr/bin/caddy
