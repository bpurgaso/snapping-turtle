{
  "name": "@snapping-turtle/extension",
  "version": "0.1.0",
  "private": true,
  "description": "MV3 browser extension: one codebase, Chrome (service worker) and Firefox (event page) builds",
  "type": "module",
  "scripts": {
    "build": "pnpm build:chrome && pnpm build:firefox",
    "build:chrome": "tsx scripts/build.ts chrome",
    "build:firefox": "tsx scripts/build.ts firefox",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@snapping-turtle/shared": "workspace:*",
    "webextension-polyfill": "0.12.0"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "@types/webextension-polyfill": "0.12.5",
    "fflate": "0.8.2",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
