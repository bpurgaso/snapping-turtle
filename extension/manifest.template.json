{
  "manifest_version": 3,
  "name": "snapping-turtle",
  "description": "Capture the current tab and share it at a private link on your own snapping-turtle server.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "snapping-turtle",
    "default_popup": "popup/index.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "options_ui": {
    "page": "options/index.html",
    "open_in_tab": true
  },
  "permissions": ["activeTab", "scripting", "storage", "notifications"],
  "optional_host_permissions": ["https://*/*"],
  "commands": {
    "capture-visible": {
      "suggested_key": { "default": "Alt+Shift+S" },
      "description": "Capture the visible part of the current tab"
    },
    "capture-region": {
      "suggested_key": { "default": "Alt+Shift+R" },
      "description": "Select a region of the current tab to capture"
    },
    "capture-full": {
      "suggested_key": { "default": "Alt+Shift+F" },
      "description": "Capture the whole page of the current tab"
    }
  }
}
